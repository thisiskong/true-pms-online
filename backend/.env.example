# Copy to .env and fill in. .env is git-ignored.
PG_DSN=postgresql://pmsonline_ro:CHANGE_ME@10.50.238.194:5432/pmsonline
PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=15000

# Chat LLM provider: anthropic (Claude API direct) | openrouter
LLM_PROVIDER=anthropic
# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Optional proxy for OpenRouter only (e.g. when a VPN blocks it): http://pve2:8888 or socks5://127.0.0.1:1080
OPENROUTER_PROXY=

# Claude API direct (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=medium
# "default" enables server-side refusal fallbacks; "off" disables them
CHAT_FALLBACKS=default

# Comma-separated bearer tokens accepted by the MCP endpoint (/mcp)
MCP_TOKENS=

# Comma-separated origins allowed by CORS (dev frontend)
CORS_ORIGINS=http://localhost:5173

# Models offered in the chat model drop-down (comma-separated ids for the active provider). Empty = built-in list.
CHAT_MODELS=
