# TEMPLATE ONLY — the real Secret is never committed to git (see ../../.gitignore).
#
# Create it manually before `kubectl apply -k overlays/prd`:
#
#   kubectl create secret generic pmsonline-credentials \
#     --namespace pmsonline-prd-pg18 \
#     --type kubernetes.io/basic-auth \
#     --from-literal=username=pmsonline \
#     --from-literal=password='pmsonline#2022'
#
# (password matches this repo's existing prod convention — see app/pgadm/run.ps1)
apiVersion: v1
kind: Secret
metadata:
  name: pmsonline-credentials
type: kubernetes.io/basic-auth
stringData:
  username: pmsonline
  password: "<FILL_IN_REAL_PROD_PASSWORD>"
