# Copy to .env (never commit .env). See DESIGN.md "Configuration" for every setting.

# Storage backend: clickhouse (default; large scale) or postgres (no ClickHouse needed)
TSDB_BACKEND=clickhouse

CH_URL=http://localhost:18123
CH_USER=pms
CH_PASSWORD=
CH_DATABASE=tsdb

# Postgres backend: tables live in schema PG_SCHEMA of the database in PG_URL
PG_URL=postgresql://localhost:15432/pmsonline
PG_USER=pms
PG_PASSWORD=
PG_SCHEMA=tsdb

# Empty disables the X-API-Key check (dev only)
TSDB_API_KEY=
TSDB_MAX_RETENTION_DAYS=400
