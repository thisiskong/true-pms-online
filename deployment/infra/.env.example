# Copy to .env and set passwords. .env is git-ignored.
# Host ports bind to 127.0.0.1. 8123 and 5432 are avoided because other local containers may use them.

# ClickHouse
CH_DB=pmsonline
CH_USER=pms
CH_PASSWORD=CHANGE_ME
CH_HTTP_PORT=18123
CH_TCP_PORT=19000

# Postgres
PG_DB=pmsonline
PG_USER=pms
PG_PASSWORD=CHANGE_ME
PG_PORT=15432
